rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /event-art/{allPaths=**} { allow read: if true; allow write: if false; }
    match /raffle-art/{allPaths=**} { allow read: if true; allow write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
