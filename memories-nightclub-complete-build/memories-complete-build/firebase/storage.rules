rules_version = '2';
// Flyers and hero images: anyone can view; only site staff can upload, images only, max 8 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function cms() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role in ['manager', 'eventManager']);
    }
    match /event-art/{file} {
      allow read: if true;
      allow create, update: if cms() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if cms();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
