rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(r) { return signedIn() && request.auth.token.role == r; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /events/{id} {
      allow read: if resource.data.visibility == 'public' || admin();
      allow write: if admin();
    }
    match /ticket_types/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /table_packages/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /bottles/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /tickets/{id} {
      allow get: if true;
      allow list: if admin();
      allow write: if false;
    }
    match /pending_checkouts/{id} {
      allow read, write: if false;
    }
    match /orders/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /checkins/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /raffles/{id} {
      allow read: if resource.data.public == true || admin();
      allow write: if false;
    }
    match /raffle_entries/{id} {
      allow read, write: if false;
    }
    match /private_event_requests/{id} {
      allow read, write: if false;
    }
    match /notification_outbox/{id} {
      allow read, write: if false;
    }
    match /audit_logs/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || admin();
      allow write: if admin();
    }
  }
}
