rules_version = '2';
// Flyers, hero images and hero videos: anyone can view; only site staff can upload.
// Images (JPEG/PNG/WebP) up to 8 MB; videos (MP4/WebM/MOV) up to 60 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function cms() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role in ['manager', 'eventManager']);
    }
    match /event-art/{file} {
      allow read: if true;
      allow create, update: if cms() && (
        (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)')) ||
        (request.resource.size < 60 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm|quicktime)')));
      allow delete: if cms();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
