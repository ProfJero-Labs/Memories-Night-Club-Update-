/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: https://*.workers.dev https://*.googleapis.com https://firebasestorage.googleapis.com https://*.firebasestorage.app; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://checkout.paystack.com
/ticket.html
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
/verify.html
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
/admin.html
  X-Robots-Tag: noindex
/organiser.html
  X-Robots-Tag: noindex
/checkin.html
  X-Robots-Tag: noindex
/login.html
  X-Robots-Tag: noindex
/assets/*
  Cache-Control: public, max-age=604800
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
